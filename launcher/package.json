{
  "name": "taft-launcher",
  "version": "1.0.0",
  "private": true,
  "description": "Тафт: Карты Альбарадура — standalone exe-лаунчер",
  "main": "dist/bundle.cjs",
  "bin": "dist/bundle.cjs",
  "scripts": {
    "build:server": "npm run build --prefix ../taft-server",
    "build:client": "npm run build --prefix ../taft-client",
    "prepare-bundle": "node scripts/prepare-bundle.js",
    "bundle": "node scripts/bundle.js",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/Taft.exe --compress GZip",
    "build:all-platforms": "pkg . --targets node18-win-x64,node18-macos-x64,node18-linux-x64 --output dist/Taft --compress GZip",
    "build": "npm run build:server && npm run build:client && npm run prepare-bundle && npm run bundle && npm run build:exe",
    "dev": "node scripts/prepare-bundle.js && node scripts/bundle.js && node dist/bundle.cjs"
  },
  "pkg": {
    "assets": [
      "public/*",
      "public/assets/*",
      "node_modules/cloudflared/bin/**/*"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "cloudflared": "^0.7.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.0",
    "localtunnel": "^2.0.2",
    "ngrok": "^5.0.0-beta.2",
    "socket.io": "^4.7.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.0",
    "@types/node": "^20.11.5",
    "@yao-pkg/pkg": "^5.12.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
