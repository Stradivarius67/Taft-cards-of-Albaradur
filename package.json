{
  "name": "taft-cards-of-albaradur",
  "version": "0.1.0",
  "private": true,
  "description": "Тафт: Карты Альбарадура — карточная мини-игра для НРИ",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "taft-server",
    "taft-client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev --workspace taft-server\" \"npm run dev --workspace taft-client\"",
    "build": "npm run build:server && npm run build:client && npm run build:copy",
    "build:server": "npm run build --workspace taft-server",
    "build:client": "npm run build --workspace taft-client",
    "build:copy": "node scripts/copy-client-build.mjs",
    "start": "node taft-server/dist/index.js",
    "start:dev": "npm run dev",
    "host": "node scripts/host.mjs",
    "test": "npm test --workspace taft-server",
    "typecheck": "npm run typecheck --workspace taft-server && npm run typecheck --workspace taft-client",
    "import-art": "tsx scripts/import-art.ts",
    "check-art": "tsx scripts/check-art.ts",
    "generate-placeholders": "tsx scripts/generate-placeholders.ts",
    "install:launcher": "npm install --prefix launcher",
    "build:exe": "npm run build --prefix launcher",
    "clean": "node -e \"const fs=require('fs');['node_modules','taft-server/node_modules','taft-client/node_modules','taft-server/public','taft-client/dist','taft-server/dist'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\""
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "tsx": "^4.7.0"
  }
}
